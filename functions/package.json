{
  "name": "mahjong416-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dataset": "npm run build && node lib/data/build-dataset.js",
    "check": "npm run build --silent && node lib/data/check-problem.js",
    "eval": "npm run build --silent && sh scripts/eval.sh",
    "pick-test": "npm run build --silent && node lib/data/pick-test.js",
    "tune": "npm run build --silent && node lib/vertex/start-tuning.js",
    "tune:status": "npm run build --silent && node lib/vertex/tuning-status.js"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@google/genai": "^2.23.0"
  }
}
